{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private Almide native HTTP example on existing AWS networking and ECS infrastructure. Creates a billable Fargate service, task definition, security group and log group; no IAM resources.",
  "Parameters": {
    "ClusterArn": {
      "Type": "String",
      "Description": "Existing ECS cluster ARN in this account and Region.",
      "AllowedPattern": "^arn:[a-z0-9-]+:ecs:[a-z0-9-]+:[0-9]{12}:cluster/.+$"
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "Existing VPC containing the private subnets and caller security group."
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Existing private IPv4 subnets in VpcId, with registry/logging egress already configured."
    },
    "CallerSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "Existing security group of the approved private caller in VpcId; its members may access TCP 8080."
    },
    "ExecutionRoleArn": {
      "Type": "String",
      "Description": "Existing ECS task execution role with ECR pull and CloudWatch Logs permissions; not an application task role.",
      "AllowedPattern": "^arn:[a-z0-9-]+:iam::[0-9]{12}:role/.+$"
    },
    "ImageUri": {
      "Type": "String",
      "Description": "Existing private ECR linux/amd64 image URI pinned to sha256 digest, never a mutable tag.",
      "AllowedPattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com(\\.cn)?/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"
    }
  },
  "Resources": {
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "LogGroupName": { "Fn::Sub": "/almide/${AWS::StackName}" },
        "RetentionInDays": 7
      }
    },
    "TaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Almide HTTP from one approved caller security group; HTTPS egress for ECR and logs",
        "VpcId": { "Ref": "VpcId" },
        "SecurityGroupIngress": [
          {
            "Description": "Private caller to Almide HTTP",
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": { "Ref": "CallerSecurityGroupId" }
          }
        ],
        "SecurityGroupEgress": [
          {
            "Description": "HTTPS through existing NAT or private AWS endpoints",
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "ExecutionRoleArn": { "Ref": "ExecutionRoleArn" },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "app",
            "Image": { "Ref": "ImageUri" },
            "Essential": true,
            "User": "65532:65532",
            "ReadonlyRootFilesystem": true,
            "Environment": [{ "Name": "PORT", "Value": "8080" }],
            "PortMappings": [{ "ContainerPort": 8080, "Protocol": "tcp" }],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": { "Ref": "LogGroup" },
                "awslogs-region": { "Ref": "AWS::Region" },
                "awslogs-stream-prefix": "app",
                "mode": "non-blocking",
                "max-buffer-size": "1m"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": { "Ref": "ClusterArn" },
        "TaskDefinition": { "Ref": "TaskDefinition" },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": 1,
        "EnableExecuteCommand": false,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": { "Enable": true, "Rollback": true }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": { "Ref": "PrivateSubnetIds" },
            "SecurityGroups": [{ "Fn::GetAtt": ["TaskSecurityGroup", "GroupId"] }]
          }
        }
      }
    }
  },
  "Outputs": {
    "ServiceName": { "Value": { "Fn::GetAtt": ["Service", "Name"] } },
    "ServiceArn": { "Value": { "Ref": "Service" } },
    "TaskDefinitionArn": { "Value": { "Ref": "TaskDefinition" } },
    "LogGroupName": { "Value": { "Ref": "LogGroup" } },
    "TaskSecurityGroupId": { "Value": { "Fn::GetAtt": ["TaskSecurityGroup", "GroupId"] } }
  }
}
